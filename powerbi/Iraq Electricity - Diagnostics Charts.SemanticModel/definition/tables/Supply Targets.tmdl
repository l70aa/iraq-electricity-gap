table 'Supply Targets'
	lineageTag: 49dc1c38-a82b-4c11-9184-103ee2837418

	measure 'التجهيز المطلوب' =
			VAR TargetPct = SELECTEDVALUE('Coverage Target'[pct], 60)
			VAR GrowthPct = SELECTEDVALUE('Demand Growth'[pct], 0)
			RETURN LOOKUPVALUE('Supply Targets'[required_supply_mw],
			                   'Supply Targets'[target_pct], TargetPct,
			                   'Supply Targets'[growth_pct], GrowthPct)
		formatString: #,0
		lineageTag: 617dcbb9-b4f3-49da-8f08-bbde0099deab

	measure 'التجهيز الإضافي' =
			VAR TargetPct = SELECTEDVALUE('Coverage Target'[pct], 60)
			VAR GrowthPct = SELECTEDVALUE('Demand Growth'[pct], 0)
			RETURN LOOKUPVALUE('Supply Targets'[additional_supply_mw],
			                   'Supply Targets'[target_pct], TargetPct,
			                   'Supply Targets'[growth_pct], GrowthPct)
		formatString: #,0
		lineageTag: b11d0087-ef20-456b-8814-103e07252b54

	column target_pct
		dataType: int64
		formatString: 0
		lineageTag: 7121c713-e74f-45af-a123-7385d9f517c3
		summarizeBy: none
		sourceColumn: target_pct

	column growth_pct
		dataType: int64
		formatString: 0
		lineageTag: 669d5f22-549f-40d3-9216-6f6ea646855d
		summarizeBy: none
		sourceColumn: growth_pct

	column required_supply_mw
		dataType: int64
		formatString: 0
		lineageTag: af3a40f4-bdcf-46fb-9bcd-939aaa261ba1
		summarizeBy: none
		sourceColumn: required_supply_mw

	column additional_supply_mw
		dataType: int64
		formatString: 0
		lineageTag: 9e2a6937-962d-4368-a982-7f2ae79b4c6d
		summarizeBy: none
		sourceColumn: additional_supply_mw

	partition 'Supply Targets' = m
		mode: import
		source = #table(type table [target_pct = Int64.Type, growth_pct = Int64.Type, required_supply_mw = Int64.Type, additional_supply_mw = Int64.Type], {{60, 0, 16731, 2053}, {60, 5, 17568, 2890}, {60, 10, 18405, 3727}, {70, 0, 19520, 4842}, {70, 5, 20496, 5818}, {70, 10, 21472, 6794}, {80, 0, 22308, 7630}, {80, 5, 23424, 8746}, {80, 10, 24539, 9861}})

	annotation PBI_ResultType = Table

