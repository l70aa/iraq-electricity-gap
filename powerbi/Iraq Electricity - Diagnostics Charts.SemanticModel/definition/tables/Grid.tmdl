		lineageTag: 58932770-7b1b-4cda-8f7f-fb33080c54a7
		summarizeBy: none
		sourceColumn: population

	column demand_mw
		dataType: int64
		lineageTag: e2eeb0ab-14a0-4c01-b518-754d75987aef
		summarizeBy: none
		sourceColumn: demand_mw

	column supplied_mw
		dataType: int64
		lineageTag: b01fd451-5268-4bd5-a470-6f729ac1aeaa
		summarizeBy: none
		sourceColumn: supplied_mw

	partition Grid = m
