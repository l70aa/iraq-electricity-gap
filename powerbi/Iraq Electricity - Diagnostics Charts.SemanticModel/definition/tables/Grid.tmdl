table Grid
	lineageTag: 33bcd786-d2a0-47b4-a205-873d64411afa

	measure السكان = SUM(Grid[population])
		formatString: #,0
		lineageTag: 63a21af5-39cc-4df7-8cb8-26f78c9079bc

	measure الطلب = SUM(Grid[demand_mw])
		formatString: #,0
		lineageTag: 0254a6c7-87cf-47d0-ad6b-2e6063f70d05

	measure التجهيز = SUM(Grid[supplied_mw])
		formatString: #,0
		lineageTag: a825f566-2872-46a9-b7b8-60842837a280

	measure العجز = [الطلب] - [التجهيز]
		formatString: #,0
		lineageTag: 2e299046-70d1-4c63-9f7c-b79ee1e7d274

	measure التغطية = DIVIDE([التجهيز], [الطلب])
		formatString: 0.00%
		lineageTag: 7ed9a25f-f737-4110-92c2-d2f73282516c

	measure 'العجز لكل 100 ألف' = DIVIDE([العجز] * 100000, [السكان])
		formatString: 0.00
		lineageTag: 9dac824f-de5e-4cd3-986d-175456863126

	column governorate
		dataType: string
		lineageTag: c8b943db-4b87-4a11-9a0d-dfabb3b9a72f
		summarizeBy: none
		sourceColumn: governorate

	column population
